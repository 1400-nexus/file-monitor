# The nexus-proto generated Python is flat (ipc_pb2.py does `import
# common_pb2`), so it must sit on sys.path as top-level modules, not inside a
# package. Required for local (non-installed) runs.
PYTHONPATH=libs/nexus-proto/generated/python

WATCH_PATH=./watch
SOCKET_PATH=./run/file-monitor.sock
RATE_CEILING_BPS=20000000
RATE_FLOOR_BPS=5000000
# fec.* values are a cross-service contract with the C++ sender/receiver —
# they must match exactly on every side. Do not change unilaterally.
FEC_K=200
FEC_N=255
FEC_SYMBOL_BYTES=1400

# Relative WATCH_PATH/SOCKET_PATH/SENDERS_BINARY_PATH above resolve against
# the config file's own directory, not the process's CWD.
SENDERS_TARGET_HOST=127.0.0.1
SENDERS_BASE_PORT=9000
SENDERS_BINARY_PATH=./bin/nexus-sender
# 0 means "supervise nothing" -- see config.toml.
SENDERS_SENDER_COUNT=0

# Directory of the .proto SOURCE files (not the generated *_pb2.py), hashed
# at startup to detect a stale wire contract. Defaults to the nexus-proto
# submodule's own proto/ directory.
PROTO_CONTRACT_DIR=libs/nexus-proto/proto
