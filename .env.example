# The nexus-proto generated Python is flat (ipc_pb2.py does `import
# common_pb2`), so it must sit on sys.path as top-level modules, not inside a
# package. Required for local (non-installed) runs.
PYTHONPATH=libs/nexus-proto/generated/python

# Every environment variable file-monitor reads is namespaced NEXUS_, so it
# can't collide with another process's variable of the same generic name
# once this runs in a shared compose stack alongside session-manager,
# s3-sync, and MinIO.
NEXUS_WATCH_PATH=./watch
NEXUS_SOCKET_PATH=./run/file-monitor.sock
NEXUS_RATE_CEILING_BPS=20000000
NEXUS_RATE_FLOOR_BPS=5000000
# fec.* values are a cross-service contract with the C++ sender/receiver —
# they must match exactly on every side. Do not change unilaterally.
NEXUS_FEC_K=200
NEXUS_FEC_N=255
NEXUS_FEC_SYMBOL_BYTES=1400

# Relative NEXUS_WATCH_PATH/NEXUS_SOCKET_PATH/NEXUS_SENDERS_BINARY_PATH above
# resolve against the config file's own directory, not the process's CWD.
NEXUS_SENDERS_TARGET_HOST=127.0.0.1
NEXUS_SENDERS_BASE_PORT=9000
NEXUS_SENDERS_BINARY_PATH=./bin/nexus-sender
# 0 means "supervise nothing" -- see config.toml.
NEXUS_SENDERS_SENDER_COUNT=0

# Directory of the .proto SOURCE files (not the generated *_pb2.py), hashed
# at startup to detect a stale wire contract. Defaults to the nexus-proto
# submodule's own proto/ directory.
NEXUS_PROTO_CONTRACT_DIR=libs/nexus-proto/proto
